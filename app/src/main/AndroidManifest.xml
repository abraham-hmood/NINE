<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Light-shell APKs are saved to /sdcard/NINE/shells (real shared storage,
         per the NINE spec) — needs All-files access granted by the user. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:name=".NineApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NINE"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NineDBT">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NineDBT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".RepositoryListActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".AddRepositoryActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".CloudModelsActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".AddCloudModelActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".AgenticToolsActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".AddToolActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".TestToolActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".ModelBrowserActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".DebuggerActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".VhdListActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <activity android:name=".VhdCreateActivity" android:exported="false" android:theme="@style/Theme.NineDBT" />
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <receiver
            android:name=".DevRunReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.nine.dbt.RUN_GUEST" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nine.dbt.vhdshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
